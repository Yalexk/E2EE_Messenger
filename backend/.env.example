# Copy to backend/.env and fill in.
MONGODB_URI=mongodb://localhost:27017/e2ee-messenger
JWT_SECRET=change-me-to-a-long-random-string
PORT=5001
# Comma-separated list of allowed browser origins (dev only; in production the
# backend serves the built frontend from the same origin).
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
