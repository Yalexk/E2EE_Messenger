{
  "name": "e2ee-messenger",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "build": "npm run build -w frontend",
    "start": "npm start -w backend",
    "test": "npm test -w shared && npm test -w backend && npm test -w frontend",
    "lint": "npm run lint -w frontend"
  }
}
